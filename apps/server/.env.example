NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"

# Server Secrets (CRITICAL: Never commit real values to version control)
JWT_SECRET="groveveil-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret-if-applicable"

# Public Google OAuth Configuration (Web Application Client ID)
# Used to strictly verify the audience claim (`aud`) of incoming mobile Google ID tokens.
GOOGLE_CLIENT_ID="mock-or-real-google-client-id.apps.googleusercontent.com"

MEDIA_STORAGE_DIR="./uploads"
APP_NAME="Groveveil"
