# Groveveil Mobile Environment Configuration Example
# Copy to .env for local overrides if needed.

# Public Google OAuth Web Client ID
# Must match the Web Client ID configured in Google Cloud Console and apps/server/.env
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="mock-or-real-google-client-id.apps.googleusercontent.com"

# Optional: Groveveil Backend API URL
# If omitted, ApiClient automatically resolves the Metro host IP on port 3000 (e.g., http://192.168.x.x:3000/api/v1)
# EXPO_PUBLIC_API_URL="http://192.168.1.7:3000/api/v1"
